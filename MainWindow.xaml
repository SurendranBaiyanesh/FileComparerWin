<Window x:Class="FileComparerWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Comparer"
        Height="880" Width="1240"
        MinHeight="700" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display">

  <DockPanel>

    <!-- ================================================================ menu -->
    <!-- Transparent rather than white, so the wash behind it runs to the top edge of the window. -->
    <Menu DockPanel.Dock="Top" Background="Transparent" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="4,2">
      <MenuItem Header="_File">
        <MenuItem Header="_Load settings…" Command="{Binding LoadSettingsCommand}" />
        <MenuItem Header="_Save settings" Command="{Binding SaveSettingsCommand}" />
        <MenuItem Header="Save settings _as…" Command="{Binding SaveSettingsAsCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Report">
        <MenuItem Header="_Copy report" Command="{Binding CopyReportCommand}" />
        <MenuItem Header="_Export report…" Command="{Binding ExportReportCommand}" />
        <MenuItem Header="Export _differences as CSV…" Command="{Binding ExportDifferencesCommand}" />
        <Separator />
        <MenuItem Header="Export as E_xcel workbook…" Command="{Binding ExportExcelReportCommand}"
                  ToolTip="Six sheets: overview, matching values, additional in the output, missing from the output, similar matches, and the differing values." />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Command line…" Command="{Binding ShowCommandLineHelpCommand}" />
        <MenuItem Header="_About…" Command="{Binding ShowAboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- ========================================================== status bar -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="14,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0"
                   Text="Exit code: 0 match · 1 differences · 2 error" />
      </Grid>
    </Border>

    <!-- ================================================================ body -->
    <Grid Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="150" />
      </Grid.RowDefinitions>

      <!-- ============================================== files and options -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="2*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <!-- The whole panel takes a drop, not only the two boxes: a path box is a few pixels tall, and
             a file dragged towards one is easily let go of just beside it. -->
        <Border x:Name="FilesCard" Grid.Column="0" Style="{StaticResource Card}"
                AllowDrop="True" DragOver="OnFileDragOver" Drop="OnCardDrop"
                PreviewDragEnter="OnCardDragEnter" DragLeave="OnCardDragLeave" PreviewDrop="OnCardPreviewDrop">
          <StackPanel>
            <TextBlock Text="FILES" Style="{StaticResource SectionHeader}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Input" Style="{StaticResource FieldLabel}" Width="54" />
              <TextBox Grid.Row="0" Grid.Column="1"
                       DataContext="{Binding Input}"
                       Text="{Binding Path=Path, UpdateSourceTrigger=PropertyChanged}"
                       AllowDrop="True" PreviewDragOver="OnFileDragOver" PreviewDrop="OnFileDrop"
                       ToolTip="Type or paste a path, or drop a file anywhere in this panel. Two files at once fill both boxes." />
              <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Margin="8,0,0,0"
                      Style="{StaticResource SecondaryButton}" Command="{Binding BrowseInputCommand}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="2,3,0,9"
                         DataContext="{Binding Input}" Text="{Binding Description}"
                         Style="{StaticResource FileHint}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Output" Style="{StaticResource FieldLabel}" Width="54" />
              <TextBox Grid.Row="2" Grid.Column="1"
                       DataContext="{Binding Output}"
                       Text="{Binding Path=Path, UpdateSourceTrigger=PropertyChanged}"
                       AllowDrop="True" PreviewDragOver="OnFileDragOver" PreviewDrop="OnFileDrop"
                       ToolTip="Type or paste a path, or drop a file anywhere in this panel. Two files at once fill both boxes." />
              <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Margin="8,0,0,0"
                      Style="{StaticResource SecondaryButton}" Command="{Binding BrowseOutputCommand}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Margin="2,3,0,0"
                         DataContext="{Binding Output}" Text="{Binding Description}"
                         Style="{StaticResource FileHint}" />

              <!-- Two headers that disagree, said as soon as both files have been read rather than left
                   for Compare, which stops with the same message spelt out in full. -->
              <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="2,9,0,0" Padding="9,6"
                      Background="{StaticResource DangerSoftBrush}" BorderBrush="#FECACA" BorderThickness="1"
                      CornerRadius="4" ToolTipService.ShowDuration="60000"
                      Visibility="{Binding HasColumnMismatch, Converter={StaticResource BoolToVisibility}}">
                <Border.ToolTip>
                  <TextBlock Text="{Binding ColumnMismatchDetail}" TextWrapping="Wrap" MaxWidth="620"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" />
                </Border.ToolTip>
                <TextBlock Text="{Binding ColumnMismatchHeadline}" Style="{StaticResource Hint}"
                           Foreground="{StaticResource DangerBrush}" />
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
          <StackPanel>
            <TextBlock Text="OPTIONS" Style="{StaticResource SectionHeader}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="132" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <CheckBox Grid.Row="0" Grid.Column="0" Content="Ignore case" IsChecked="{Binding IgnoreCase}"
                        ToolTip="Compare values without regard to case." />
              <CheckBox Grid.Row="1" Grid.Column="0" Content="Trim values" IsChecked="{Binding TrimValues}"
                        ToolTip="Trim leading and trailing whitespace before comparing." />
              <CheckBox Grid.Row="2" Grid.Column="0" Content="Similar match (123.00 = 123)" IsChecked="{Binding SimilarMatch}"
                        Margin="0,0,0,2"
                        ToolTip="Compare plain numbers by value rather than by how they are written. This decides which rows pair up as well." />

              <!-- An option of Similar match rather than one of its own, so it sits under it and greys out with it. -->
              <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="24,0,0,8"
                          IsEnabled="{Binding SimilarMatch}"
                          ToolTip="How far apart two numbers may be and still count as equal. 0 requires them to be exactly equal; 1 lets 100 match 99 to 101, and 2 lets it match 98 to 102.">
                <TextBlock Text="±" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                <TextBox Width="58" Text="{Binding SimilarMatchRangeText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="range" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>

              <!-- Delimiter and Encoding start at the top of their column now that Max rows and Sheet
                   are gone, so the right-hand pair lines up with the checkboxes beside them. -->
              <TextBlock Grid.Row="0" Grid.Column="1" Text="Delimiter" Style="{StaticResource FieldLabel}" Margin="14,0,10,0" />
              <ComboBox Grid.Row="0" Grid.Column="2" Margin="0,0,0,6" IsEditable="True"
                        ItemsSource="{Binding DelimiterChoices}"
                        Text="{Binding SelectedDelimiter, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Delimiter for text files. 'detect' reads it from the header line, trying ; , tab and |. Longer delimiters are allowed; |&quot; has to be chosen, since detection cannot tell it from a plain pipe." />

              <TextBlock Grid.Row="1" Grid.Column="1" Text="Encoding" Style="{StaticResource FieldLabel}" Margin="14,0,10,0" />
              <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,0,0,6" IsEditable="True" IsReadOnly="True"
                        ItemsSource="{Binding EncodingChoices}"
                        Text="{Binding SelectedEncoding, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="'detect' means: byte order mark, else UTF-8, else Windows-1252." />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ========================================================== columns -->
      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="COLUMNS" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Key" Style="{StaticResource Hint}" Margin="1,0,0,3" />
            <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Text="Compare" Style="{StaticResource Hint}" Margin="13,0,0,3" />

            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding KeyColumns, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Comma separated, e.g. Name,PersonNumber" />
            <Button Grid.Row="1" Grid.Column="1" Content="Pick…" Margin="6,0,0,0" MinWidth="62"
                    Style="{StaticResource SecondaryButton}" Command="{Binding PickKeyColumnsCommand}" />

            <TextBox Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" Text="{Binding CompareColumns, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Empty compares every column the two files share. Name the columns here to leave the others out." />
            <Button Grid.Row="1" Grid.Column="3" Content="Pick…" Margin="6,0,0,0" MinWidth="62"
                    Style="{StaticResource SecondaryButton}" Command="{Binding PickCompareColumnsCommand}" />

            <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Style="{StaticResource Hint}" Margin="1,7,0,0" TextTrimming="None" TextWrapping="Wrap"
                       Text="Rows are paired on the key columns, which must exist in both files; their order does not matter. Compare left empty means every column the two files share; naming columns there is how the rest — an export timestamp, a running number — are left out." />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ========================================================== actions -->
      <Grid Grid.Row="2" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Hint}"
                   Text="Delimited text · XML · JSON · Excel. The two files need not share a format or an encoding, but must carry the same columns." />

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Swap" Style="{StaticResource SecondaryButton}" Command="{Binding SwapFilesCommand}"
                  ToolTip="Exchange the input and output files." />
          <Button Content="Clear" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ClearResultsCommand}" />
          <!-- Left of Compare, so the primary action stays the last thing on the row. It disables
               itself until there is a comparison to write, the same as the menu entry. -->
          <Button Content="Export Excel…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                  Command="{Binding ExportExcelReportCommand}"
                  ToolTip="Write the run to a workbook: overview, matching values, additional in the output, missing from the output, similar matches, and the differing values." />
          <Button Content="Compare" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="124"
                  Command="{Binding CompareCommand}" IsDefault="True" />
        </StackPanel>
      </Grid>

      <!-- ========================================================== verdict -->
      <Border Grid.Row="3" Margin="0,12,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Verdict}" Value="Success">
                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                <Setter Property="BorderBrush" Value="#A7F3D0" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Verdict}" Value="Failure">
                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                <Setter Property="BorderBrush" Value="#FECACA" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>

        <!-- The tiles size to their contents and the headline takes what is left. The other way round,
             the summary - which names every compared column and runs to hundreds of characters on a
             real file - would size its own column and squeeze the counts off the banner. -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="140" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="{Binding VerdictHeadline}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Verdict}" Value="Success">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Verdict}" Value="Failure">
                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding VerdictDetail}" FontSize="13.5" Margin="10,0,0,0" VerticalAlignment="Center"
                         Foreground="{StaticResource TextBrush}" />
          </StackPanel>

          <!-- Full width and trimmed, with the whole of it wrapped onto the tooltip. -->
          <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,7,0,0"
                     Text="{Binding ComparisonSummary}" Style="{StaticResource Hint}"
                     ToolTipService.ShowDuration="60000">
            <TextBlock.ToolTip>
              <TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" MaxWidth="620" />
            </TextBlock.ToolTip>
          </TextBlock>

          <UniformGrid Grid.Row="0" Grid.Column="1" Rows="1" VerticalAlignment="Center">
            <Border Style="{StaticResource CountTile}">
              <StackPanel>
                <TextBlock Text="Rows in input" Style="{StaticResource CountLabel}" />
                <TextBlock Text="{Binding InputRowCount, StringFormat=N0}" Style="{StaticResource CountValue}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CountTile}">
              <StackPanel>
                <TextBlock Text="Rows in output" Style="{StaticResource CountLabel}" />
                <TextBlock Text="{Binding OutputRowCount, StringFormat=N0}" Style="{StaticResource CountValue}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CountTile}">
              <StackPanel>
                <TextBlock Text="Matching" Style="{StaticResource CountLabel}" />
                <TextBlock Text="{Binding MatchedRowCount, StringFormat=N0}" Style="{StaticResource CountValueGood}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CountTile}">
              <StackPanel>
                <TextBlock Text="Value differences" Style="{StaticResource CountLabel}" />
                <TextBlock Text="{Binding ValueDifferenceRowCount, StringFormat=N0}" Style="{StaticResource CountValueBad}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CountTile}">
              <StackPanel>
                <TextBlock Text="Missing in output" Style="{StaticResource CountLabel}" />
                <TextBlock Text="{Binding MissingRowCount, StringFormat=N0}" Style="{StaticResource CountValueBad}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CountTile}" Margin="0">
              <StackPanel>
                <TextBlock Text="Extra in output" Style="{StaticResource CountLabel}" />
                <TextBlock Text="{Binding ExtraRowCount, StringFormat=N0}" Style="{StaticResource CountValueBad}" />
              </StackPanel>
            </Border>
          </UniformGrid>
        </Grid>
      </Border>

      <!-- =========================================================== output -->
      <Grid Grid.Row="4" Margin="0,12,0,0">

        <!-- error -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Top"
                Background="{StaticResource DangerSoftBrush}" BorderBrush="#FECACA"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="COULD NOT COMPARE" Style="{StaticResource SectionHeader}" Foreground="{StaticResource DangerBrush}" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                       FontFamily="{StaticResource MonoFont}" FontSize="12" />
          </StackPanel>
        </Border>

        <!-- nothing run yet -->
        <Border VerticalAlignment="Stretch">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasResult}" Value="False" />
                    <Condition Binding="{Binding HasError}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="No comparison yet" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" HorizontalAlignment="Center"
                       Text="Choose two files, name the key column(s), then press Compare." />
          </StackPanel>
        </Border>

        <!-- results -->
        <TabControl Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">

          <TabItem>
            <TabItem.Header>
              <TextBlock Text="{Binding ValueDifferenceRowCount, StringFormat='Value differences ({0})'}" />
            </TabItem.Header>
            <DockPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource FilterFooter}"
                    Visibility="{Binding DifferenceFilters.IsActive, Converter={StaticResource BoolToVisibility}}">
              <Grid>
                <TextBlock Text="{Binding DifferencesFilterSummary}" Style="{StaticResource Hint}"
                           Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                <Button Content="Clear filters" HorizontalAlignment="Right" Padding="8,2" MinWidth="0"
                        Style="{StaticResource SecondaryButton}" Command="{Binding ClearDifferenceFiltersCommand}" />
              </Grid>
            </Border>
            <DataGrid ItemsSource="{Binding DifferencesView}" RowDetailsVisibilityMode="VisibleWhenSelected">
              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Key}" MaxWidth="380">
                  <DataGridTextColumn.HeaderTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="Key" Style="{StaticResource ColumnTitle}" />
                        <TextBox Style="{StaticResource FilterBox}"
                                 AutomationProperties.Name="Filter Key"
                                 Text="{Binding DataContext.DifferenceFilters.Key.Text, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Column}" MaxWidth="260">
                  <DataGridTextColumn.HeaderTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="Column" Style="{StaticResource ColumnTitle}" />
                        <TextBox Style="{StaticResource FilterBox}"
                                 AutomationProperties.Name="Filter Column"
                                 Text="{Binding DataContext.DifferenceFilters.Column.Text, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTemplateColumn MaxWidth="300">
                  <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="Input value" Style="{StaticResource ColumnTitle}" />
                        <TextBox Style="{StaticResource FilterBox}"
                                 AutomationProperties.Name="Filter Input value"
                                 Text="{Binding DataContext.DifferenceFilters.InputValue.Text, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.HeaderTemplate>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding InputValue}" Style="{StaticResource ValueCell}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn MaxWidth="300">
                  <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="Output value" Style="{StaticResource ColumnTitle}" />
                        <TextBox Style="{StaticResource FilterBox}"
                                 AutomationProperties.Name="Filter Output value"
                                 Text="{Binding DataContext.DifferenceFilters.OutputValue.Text, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.HeaderTemplate>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding OutputValue}" Style="{StaticResource ValueCell}"
                                 Foreground="{StaticResource DangerBrush}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding InputLine}">
                  <DataGridTextColumn.HeaderTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="Input line" Style="{StaticResource ColumnTitle}" />
                        <TextBox Style="{StaticResource FilterBox}"
                                 AutomationProperties.Name="Filter Input line"
                                 Text="{Binding DataContext.DifferenceFilters.InputLine.Text, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding OutputLine}">
                  <DataGridTextColumn.HeaderTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="Output line" Style="{StaticResource ColumnTitle}" />
                        <TextBox Style="{StaticResource FilterBox}"
                                 AutomationProperties.Name="Filter Output line"
                                 Text="{Binding DataContext.DifferenceFilters.OutputLine.Text, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
              </DataGrid.Columns>
              <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                  <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,1" Padding="12,8">
                    <StackPanel>
                      <TextBlock Style="{StaticResource ValueCell}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
                        <TextBlock.Text>
                          <MultiBinding StringFormat="input  (line {0}): {1}">
                            <Binding Path="InputLine" />
                            <Binding Path="InputRowText" />
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                      <TextBlock Style="{StaticResource ValueCell}" TextWrapping="Wrap" Margin="0,4,0,0"
                                 Foreground="{StaticResource MutedBrush}">
                        <TextBlock.Text>
                          <MultiBinding StringFormat="output (line {0}): {1}">
                            <Binding Path="OutputLine" />
                            <Binding Path="OutputRowText" />
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </DataGrid.RowDetailsTemplate>
            </DataGrid>
            </DockPanel>
          </TabItem>

          <TabItem>
            <TabItem.Header>
              <TextBlock Text="{Binding MissingRowCount, StringFormat='Missing in output ({0})'}" />
            </TabItem.Header>
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource FilterFooter}"
                      Visibility="{Binding MissingFilters.IsActive, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                  <TextBlock Text="{Binding MissingRowsFilterSummary}" Style="{StaticResource Hint}"
                             Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                  <Button Content="Clear filters" HorizontalAlignment="Right" Padding="8,2" MinWidth="0"
                          Style="{StaticResource SecondaryButton}" Command="{Binding ClearMissingFiltersCommand}" />
                </Grid>
              </Border>
              <DataGrid ItemsSource="{Binding MissingRowsView}">
                <DataGrid.Columns>
                  <DataGridTextColumn Binding="{Binding Key}" MaxWidth="420">
                    <DataGridTextColumn.HeaderTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="Key" Style="{StaticResource ColumnTitle}" />
                          <TextBox Style="{StaticResource FilterBox}"
                                   AutomationProperties.Name="Filter Key"
                                   Text="{Binding DataContext.MissingFilters.Key.Text, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                  </DataGridTextColumn>
                  <DataGridTextColumn Binding="{Binding LineNumber}">
                    <DataGridTextColumn.HeaderTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="Line" Style="{StaticResource ColumnTitle}" />
                          <TextBox Style="{StaticResource FilterBox}"
                                   AutomationProperties.Name="Filter Line"
                                   Text="{Binding DataContext.MissingFilters.Line.Text, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="Row" Style="{StaticResource ColumnTitle}" />
                          <TextBox Style="{StaticResource FilterBox}"
                                   AutomationProperties.Name="Filter Row"
                                   Text="{Binding DataContext.MissingFilters.Row.Text, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding RowText}" Style="{StaticResource ValueCell}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <TabItem>
            <TabItem.Header>
              <TextBlock Text="{Binding ExtraRowCount, StringFormat='Extra in output ({0})'}" />
            </TabItem.Header>
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource FilterFooter}"
                      Visibility="{Binding ExtraFilters.IsActive, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                  <TextBlock Text="{Binding ExtraRowsFilterSummary}" Style="{StaticResource Hint}"
                             Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                  <Button Content="Clear filters" HorizontalAlignment="Right" Padding="8,2" MinWidth="0"
                          Style="{StaticResource SecondaryButton}" Command="{Binding ClearExtraFiltersCommand}" />
                </Grid>
              </Border>
              <DataGrid ItemsSource="{Binding ExtraRowsView}">
                <DataGrid.Columns>
                  <DataGridTextColumn Binding="{Binding Key}" MaxWidth="420">
                    <DataGridTextColumn.HeaderTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="Key" Style="{StaticResource ColumnTitle}" />
                          <TextBox Style="{StaticResource FilterBox}"
                                   AutomationProperties.Name="Filter Key"
                                   Text="{Binding DataContext.ExtraFilters.Key.Text, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                  </DataGridTextColumn>
                  <DataGridTextColumn Binding="{Binding LineNumber}">
                    <DataGridTextColumn.HeaderTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="Line" Style="{StaticResource ColumnTitle}" />
                          <TextBox Style="{StaticResource FilterBox}"
                                   AutomationProperties.Name="Filter Line"
                                   Text="{Binding DataContext.ExtraFilters.Line.Text, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="Row" Style="{StaticResource ColumnTitle}" />
                          <TextBox Style="{StaticResource FilterBox}"
                                   AutomationProperties.Name="Filter Row"
                                   Text="{Binding DataContext.ExtraFilters.Row.Text, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding RowText}" Style="{StaticResource ValueCell}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <TabItem>
            <TabItem.Header>
              <TextBlock Text="{Binding WarningCount, StringFormat='Warnings ({0})'}" />
            </TabItem.Header>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Warnings}" Margin="10">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="#FDE68A" BorderThickness="1"
                              CornerRadius="4" Padding="10,7" Margin="0,0,0,6">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </TabItem>

          <TabItem Header="Report">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Copy" Style="{StaticResource SecondaryButton}" Command="{Binding CopyReportCommand}" />
                <Button Content="Export…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ExportReportCommand}" />
                <Button Content="Export differences…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ExportDifferencesCommand}" />
              </StackPanel>
              <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True"
                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                       TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       BorderThickness="1" Padding="10" />
            </DockPanel>
          </TabItem>
        </TabControl>

        <!-- busy -->
        <Border Background="#B3FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,10,0,0" BorderThickness="0"
                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrushSoft}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
