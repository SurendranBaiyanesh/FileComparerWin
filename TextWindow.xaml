<Window x:Class="FileComparerWindows.TextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="760"
        MinHeight="300" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Copy" Style="{StaticResource SecondaryButton}" Click="OnCopy" />
      <Button Content="Close" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsCancel="True" IsDefault="True" />
    </StackPanel>

    <TextBox x:Name="Body" IsReadOnly="True" Padding="12"
             FontFamily="{StaticResource MonoFont}" FontSize="12.5"
             TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
