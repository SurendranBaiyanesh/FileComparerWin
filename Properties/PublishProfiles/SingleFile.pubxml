<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes the application as one self-contained executable: the .NET runtime, WPF and every
  native library travel inside the file, so it runs on a machine that has nothing installed.

  IncludeAllContentForSelfExtract is deliberately left off. It would move AppContext.BaseDirectory
  to the temporary extraction folder, and appsettings.json is read from and written back to that
  directory - the settings would be saved somewhere the next run never looks.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF cannot be trimmed: XAML resolves types by name, so the trimmer would remove code the
         application still reaches for. -->
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Symbols go inside the assembly rather than beside it, so the publish folder holds one file
         and a stack trace still names the line it came from. -->
    <DebugType>embedded</DebugType>
    <PublishDir>bin\publish\</PublishDir>
  </PropertyGroup>
</Project>
