<Window x:Class="FileComparerWindows.ColumnPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="560" Width="540"
        MinHeight="360" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display">

  <DockPanel Margin="16">

    <TextBlock DockPanel.Dock="Top" x:Name="PromptText" Style="{StaticResource Hint}"
               TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,12" />

    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Filter" Style="{StaticResource FieldLabel}" />
      <TextBox Grid.Column="1" x:Name="FilterBox" TextChanged="OnFilterChanged"
               ToolTip="Type to narrow the list. All and None then act on what is shown." />
    </Grid>

    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Button Content="All" Style="{StaticResource SecondaryButton}" MinWidth="56" Click="OnSelectAll" />
        <Button Content="None" Style="{StaticResource SecondaryButton}" MinWidth="56" Margin="8,0,0,0" Click="OnSelectNone" />
      </StackPanel>

      <TextBlock Grid.Column="1" x:Name="SelectionCount" Style="{StaticResource Hint}"
                 VerticalAlignment="Center" HorizontalAlignment="Center" />

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" />
        <Button Content="OK" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True" Click="OnAccept" />
      </StackPanel>
    </Grid>

    <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="4">
      <ListBox x:Name="ColumnList" BorderThickness="0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               HorizontalContentAlignment="Stretch">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding IsSelected}" Margin="2,3" VerticalContentAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Availability}" Style="{StaticResource Hint}" Margin="10,0,0,0"
                           VerticalAlignment="Center" TextTrimming="None" />
              </StackPanel>
            </CheckBox>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
