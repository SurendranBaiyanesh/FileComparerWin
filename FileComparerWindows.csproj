<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FileComparerWindows</RootNamespace>
    <AssemblyName>FileComparerWindows</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <!-- The assembly's identity. The build turns these into assembly attributes and into the Win32
       version resource behind the Details tab of the file's properties, which is the only account a
       published executable can give of itself once it has been copied away from here on its own.
       Attributes that no property covers are in Properties\AssemblyInfo.cs. -->
  <PropertyGroup>
    <Product>File Comparer</Product>
    <AssemblyTitle>File Comparer</AssemblyTitle>
    <Description>Compares an input file and an output file row by row, pairing rows by one or more key columns.</Description>
    <Company>Surendran Balamurugan</Company>
    <Authors>Surendran Balamurugan</Authors>
    <Copyright>Copyright © 2026 Surendran Balamurugan</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- A WPF project leaves System.IO out of the implicit usings, because System.Windows.Shapes.Path
         would then collide with System.IO.Path. This application reads files far more often than it
         draws shapes, so the collision is settled the other way round. -->
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Shapes" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both sit beside the build output so that dotnet run has settings and sample files to hand,
         and neither is published: the published application is meant to be one executable and nothing
         else. A missing settings file costs nothing, since the application starts on its defaults and
         writes the file itself the first time settings are saved. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Update="samples\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
