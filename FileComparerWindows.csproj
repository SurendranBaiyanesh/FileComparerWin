<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FileComparerWindows</RootNamespace>
    <AssemblyName>FileComparerWindows</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- A WPF project leaves System.IO out of the implicit usings, because System.Windows.Shapes.Path
         would then collide with System.IO.Path. This application reads files far more often than it
         draws shapes, so the collision is settled the other way round. -->
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Shapes" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="samples\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
